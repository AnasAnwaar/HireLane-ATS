# Copy to .env.local and fill in. .env.local is git-ignored — never commit real keys.

# --- Supabase -------------------------------------------------------------
# Project Settings -> API (or the "Connect" button) in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row-Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (migrations & test scripts only; the app doesn't use these) --
# Supabase -> Settings -> Database -> Connection string.
# DIRECT_URL: the "Session pooler" URI on port 5432 (DDL/migrations).
# DATABASE_URL: the transaction pooler on :6543 (app-style pooled connection).
DIRECT_URL=postgresql://postgres.your-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI: Gemini / Google (needed from CP-11: post generation, screening, tests) ----
# Get a key at https://aistudio.google.com/apikey — usually starts with "AIza".
GEMINI_API_KEY=

# --- Email: Resend (contact form, candidate portal links, notifications) ---
# Get a key at https://resend.com -> API Keys. See SMTP-SETUP.md for details.
RESEND_API_KEY=
# Sender. Use onboarding@resend.dev until you verify a domain in Resend.
EMAIL_FROM=HireLane <onboarding@resend.dev>
# Where landing-page contact-form messages are delivered.
CONTACT_EMAIL=you@example.com

# --- Stripe billing (test mode, CP-27) ------------------------------------
# Dashboard -> Developers -> API keys (with "Test mode" on). Test keys start
# with sk_test_ / pk_test_. Run `npm run stripe:setup` once to create the
# products/prices. STRIPE_WEBHOOK_SECRET comes from `stripe listen` (dev) or the
# dashboard webhook endpoint (prod).
STRIPE_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
